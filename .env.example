NODE_ENV="development" # Options: 'development', 'production'
PORT="8080"
HOST="localhost"

# CORS Settings
CORS_ORIGIN="*" # Comma-separated allowed origins. Supports wildcard patterns (e.g. https://*.typingmind.com,http://localhost:*)

# Rate Limiting
COMMON_RATE_LIMIT_WINDOW_MS="1000" # Window size for rate limiting (ms)
COMMON_RATE_LIMIT_MAX_REQUESTS="20" # Max number of requests per window per IP

# Optional: Pi ExpressVPN DNS workaround for Places outbound only (comma-separated).
# GOOGLE_HTTP_DNS_SERVERS=1.1.1.1,8.8.8.8

# Multi-agent runner. Leave OPENAI_API_KEY empty; the TypingMind plugin
# sends the key per request. Never commit a real key.
# OPENAI_API_KEY=
# Fallback only if the plugin omits max_agents. Per-use-case cap is the
# TypingMind plugin User Setting — do not change this on the Pi for that.
MULTI_AGENT_DEFAULT_MAX_AGENTS="4"
MULTI_AGENT_DEFAULT_MODEL="gpt-6-astra"
